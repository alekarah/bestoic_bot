# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Admin Telegram User IDs (comma-separated for multiple admins)
# You can use either ADMIN_USER_IDS for multiple admins or ADMIN_USER_ID for a single admin
# Examples:
#   Single admin:   ADMIN_USER_IDS=123456789
#   Multiple admins: ADMIN_USER_IDS=123456789,987654321
ADMIN_USER_IDS=your_user_id_here

# Legacy support - if you prefer the old format, you can still use:
# ADMIN_USER_ID=your_user_id_here
